# Copy to .env and fill in. The .env file itself is git-ignored.
NODE_ENV=development
PORT=8000

MONGO_URI=mongodb://localhost:27017/restaurant

SECRET_KEY=generate_with_openssl_rand_hex_48

CLIENT_URL=http://localhost:5180
FRONTEND_URL=http://localhost:5180

# Cloudinary — image uploads (https://cloudinary.com, free tier)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Mailtrap — transactional email sandbox (https://mailtrap.io, free tier)
MAILTRAP_API_TOKEN=

# Stripe — test mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
WEBHOOK_ENDPOINT_SECRET=

# Sender identity for outgoing email.
# On Mailtrap's free demo domain the sender must be @demomailtrap.co
# and mail can only be delivered to your own Mailtrap account address.
MAIL_FROM_EMAIL=hello@demomailtrap.co
MAIL_FROM_NAME=Gourmand
