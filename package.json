{
  "name": "gourmand",
  "version": "1.0.0",
  "description": "Food ordering platform with restaurant management, Stripe checkout and role-based admin",
  "main": "server/index.ts",
  "scripts": {
    "dev": "nodemon server/index.ts",
    "seed": "ts-node server/seed/index.ts",
    "stripe": "stripe listen --forward-to localhost:8000/api/v1/order/webhook",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm install --include=dev && npm install --prefix client --include=dev && npm run build --prefix client && npm run build:server",
    "start": "node dist/server/index.js"
  },
  "keywords": [],
  "author": "Krishna Gurjar",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mailtrap": "^3.4.0",
    "mongoose": "^8.5.4",
    "multer": "^1.4.5-lts.1",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
